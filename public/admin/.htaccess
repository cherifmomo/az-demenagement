# ============================================================
# Administration du site
# - index.php = page de connexion (identifiant + mot de passe
#   définis dans le fichier .env de ce dossier)
# - le fichier .env est inaccessible depuis le web
# ============================================================

DirectoryIndex index.php

# Bloquer l'accès web au fichier .env (lisible uniquement en FTP)
<Files ".env">
  Require all denied
</Files>
