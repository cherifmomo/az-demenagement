---
// Logo AZ Déménagement — SVG inline (aucune requête réseau, rendu immédiat).
// Pour utiliser un logo officiel, remplacez le contenu de ce composant.
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: className = '' } = Astro.props;
const text = variant === 'light' ? '#ffffff' : '#132b50';
const sub = variant === 'light' ? '#b9c6da' : '#5b6b83';
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 276 56"
  width="276"
  height="56"
  role="img"
  aria-label="AZ Déménagement"
>
  <defs>
    <linearGradient id={`az-g-${variant}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1d4ed8"></stop>
      <stop offset="1" stop-color="#132b50"></stop>
    </linearGradient>
  </defs>
  <!-- Monogramme : boîte + flèche de mouvement -->
  <rect x="2" y="6" width="44" height="44" rx="11" fill={`url(#az-g-${variant})`}></rect>
  <text
    x="24"
    y="36.5"
    text-anchor="middle"
    font-family="'Bricolage Grotesque Variable','Arial Black',sans-serif"
    font-weight="800"
    font-size="21"
    letter-spacing="-0.5"
    fill="#ffffff">AZ</text>
  <path d="M12 44.5h24" stroke="#f59e0b" stroke-width="3.5" stroke-linecap="round"></path>
  <path d="M36 44.5l-4-3.2M36 44.5l-4 3.2" stroke="#f59e0b" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <!-- Nom -->
  <text
    x="56"
    y="27"
    font-family="'Bricolage Grotesque Variable','Arial Black',sans-serif"
    font-weight="800"
    font-size="20.5"
    letter-spacing="-0.3"
    fill={text}>AZ Déménagement</text>
  <text
    x="56.5"
    y="45"
    font-family="'Inter Variable',Arial,sans-serif"
    font-weight="600"
    font-size="11.5"
    letter-spacing="1.6"
    fill={sub}>BRUXELLES · INTERNATIONAL</text>
</svg>
