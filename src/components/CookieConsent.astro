---
// Bannière de consentement cookies (RGPD) compatible Google Consent Mode v2.
// - Tout accepter / Tout refuser / Personnaliser
// - Choix mémorisé en localStorage, réappliqué avant les tags (AnalyticsHead)
// - Réouvrable via n'importe quel élément [data-open-cookie-settings]
import { analytics } from '../data/analytics';
---

<div
  class="cc"
  id="cookie-consent"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cc-title"
  aria-describedby="cc-text"
  hidden
  data-storage-key={analytics.consentStorageKey}
  data-version={analytics.consentVersion}
>
  <div class="cc-inner">
    <div class="cc-main">
      <p class="cc-title" id="cc-title">Respect de votre vie privée</p>
      <p class="cc-text" id="cc-text">
        Nous utilisons des cookies de mesure d'audience (Google Analytics) et, si vous
        l'acceptez, des cookies publicitaires pour évaluer l'efficacité de nos campagnes.
        Vous pouvez accepter, refuser ou personnaliser vos choix à tout moment.
        <a href="/politique-cookies/">Politique de cookies</a>
      </p>

      <div class="cc-panel" id="cc-panel" hidden>
        <label class="cc-option">
          <span class="cc-option-text">
            <strong>Strictement nécessaires</strong>
            <span>Fonctionnement du site et mémorisation de vos choix. Toujours actifs.</span>
          </span>
          <input type="checkbox" checked disabled />
        </label>
        <label class="cc-option">
          <span class="cc-option-text">
            <strong>Mesure d'audience</strong>
            <span>Google Analytics : statistiques anonymisées de fréquentation pour améliorer le site.</span>
          </span>
          <input type="checkbox" id="cc-analytics" />
        </label>
        <label class="cc-option">
          <span class="cc-option-text">
            <strong>Publicité</strong>
            <span>Mesure des conversions et personnalisation des annonces (Google Ads).</span>
          </span>
          <input type="checkbox" id="cc-ads" />
        </label>
      </div>
    </div>

    <div class="cc-actions">
      <button type="button" class="btn btn--primary" data-cc="accept">Tout accepter</button>
      <button type="button" class="btn btn--outline" data-cc="reject">Tout refuser</button>
      <button type="button" class="btn btn--outline" data-cc="customize">Personnaliser</button>
      <button type="button" class="btn btn--dark" data-cc="save" hidden>Enregistrer mes choix</button>
    </div>
  </div>
</div>

<style>
  .cc {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    padding: 1rem clamp(1rem, 3vw, 2rem) calc(1rem + env(safe-area-inset-bottom));
    background: #ffffff;
    border-top: 1px solid var(--line);
    box-shadow: 0 -12px 40px rgb(13 31 60 / 0.16);
    font-size: 0.95rem;
  }

  .cc-inner {
    max-width: var(--container);
    margin-inline: auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .cc-main { flex: 1; min-width: 0; }

  .cc-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--navy-800);
    margin: 0 0 0.3rem;
  }

  .cc-text { color: var(--ink-soft); margin: 0; }

  .cc-panel {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--line);
  }

  .cc-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
  }

  .cc-option-text { display: grid; }
  .cc-option-text strong { color: var(--ink); }
  .cc-option-text span:last-child { color: var(--ink-mute); font-size: 0.88rem; }

  .cc-option input {
    width: 1.3rem;
    height: 1.3rem;
    flex-shrink: 0;
    accent-color: var(--blue-600);
  }

  .cc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .cc-actions .btn { padding: 0.65rem 1.2rem; font-size: 0.93rem; }

  @media (max-width: 860px) {
    .cc { padding-bottom: calc(4.6rem + env(safe-area-inset-bottom)); }
    .cc-inner { flex-direction: column; gap: 1rem; }
    .cc-actions { width: 100%; }
    .cc-actions .btn { flex: 1 1 auto; }
  }
</style>

<script>
  type Consent = { v: number; analytics: boolean; ads: boolean; ts: number };

  const root = document.getElementById('cookie-consent') as HTMLElement | null;

  if (root) {
    const KEY = root.dataset.storageKey!;
    const VERSION = Number(root.dataset.version);
    const panel = document.getElementById('cc-panel')!;
    const cbAnalytics = document.getElementById('cc-analytics') as HTMLInputElement;
    const cbAds = document.getElementById('cc-ads') as HTMLInputElement;
    const btnSave = root.querySelector<HTMLButtonElement>('[data-cc="save"]')!;
    const btnCustomize = root.querySelector<HTMLButtonElement>('[data-cc="customize"]')!;

    const w = window as any;
    w.dataLayer = w.dataLayer || [];
    const gtag = (...args: unknown[]) => { w.dataLayer.push(args); };

    const SIX_MONTHS = 182 * 24 * 60 * 60 * 1000;

    const read = (): Consent | null => {
      try {
        const c = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (!c || c.v !== VERSION) return null;
        if (Date.now() - (c.ts || 0) > SIX_MONTHS) { localStorage.removeItem(KEY); return null; }
        return c;
      } catch { return null; }
    };

    const apply = (analytics: boolean, ads: boolean) => {
      const consent: Consent = { v: VERSION, analytics, ads, ts: Date.now() };
      try { localStorage.setItem(KEY, JSON.stringify(consent)); } catch {}
      w.__azConsent = consent;
      gtag('consent', 'update', {
        analytics_storage: analytics ? 'granted' : 'denied',
        ad_storage: ads ? 'granted' : 'denied',
        ad_user_data: ads ? 'granted' : 'denied',
        ad_personalization: ads ? 'granted' : 'denied',
      });
      // Événement technique (non personnel) pour déclencher des tags GTM après consentement
      w.dataLayer.push({ event: 'consent_update', consent_analytics: analytics, consent_ads: ads });
      hide();
    };

    const show = (customize = false) => {
      const c = read();
      cbAnalytics.checked = c?.analytics ?? false;
      cbAds.checked = c?.ads ?? false;
      panel.hidden = !customize;
      btnSave.hidden = !customize;
      btnCustomize.hidden = customize;
      root.hidden = false;
    };

    const hide = () => { root.hidden = true; };

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cc]');
      if (!btn) return;
      switch (btn.dataset.cc) {
        case 'accept': apply(true, true); break;
        case 'reject': apply(false, false); break;
        case 'customize': show(true); break;
        case 'save': apply(cbAnalytics.checked, cbAds.checked); break;
      }
    });

    // Lien « Gérer les cookies » (footer, page cookies…)
    document.querySelectorAll('[data-open-cookie-settings]').forEach((el) => {
      el.addEventListener('click', (e) => { e.preventDefault(); show(true); });
    });

    // Première visite : afficher la bannière
    if (!read()) show(false);
  }
</script>
