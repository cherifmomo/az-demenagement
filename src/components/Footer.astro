---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company } from '../data/company';
import { services } from '../data/services';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="light" class="footer-logo" />
        <p>
          Entreprise de déménagement à Bruxelles. Déménagements de particuliers et
          d'entreprises, en Belgique et à l'international.
        </p>
        <a href={company.quoteUrl} target="_blank" rel="noopener" class="btn btn--primary">Demander un devis gratuit</a>
      </div>

      <nav class="footer-col" aria-label="Liens du site">
        <h2>Navigation</h2>
        <ul>
          <li><a href="/">Accueil</a></li>
          <li><a href="/services/">Services</a></li>
          <li><a href="/demenagement-international/">Déménagement international</a></li>
          <li><a href="/zones-intervention/">Zones d'intervention</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href={company.quoteUrl} target="_blank" rel="noopener">Demande de devis</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Nos services">
        <h2>Nos services</h2>
        <ul>
          {services.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.external ? '_blank' : undefined}
                rel={s.external ? 'noopener' : undefined}
              >{s.shortTitle}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-col footer-contact">
        <h2>Retrouvez-nous</h2>
        <address>
          <p>
            <strong>{company.legalName}</strong><br />
            {company.address.street}<br />
            {company.address.postalCode} {company.address.city}<br />
            {company.address.country}
          </p>
          <p>TVA : {company.vat}</p>
          <p>
            <a href={company.phoneHref}>
              <Icon name="phone" size={16} /> {company.phoneDisplay}
            </a>
          </p>
          <p>
            <a href={`mailto:${company.email}`}>
              <Icon name="mail" size={16} /> {company.email}
            </a>
          </p>
        </address>
        <h2>Heures d'ouverture</h2>
        <ul class="hours">
          {company.openingHours.map((h) => (
            <li><span>{h.days}</span> : {h.hours}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {company.legalName} — {company.brand}. Tous droits réservés.</p>
      <ul>
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li><a href="/politique-de-confidentialite/">Politique de confidentialité</a></li>
        <li><a href="/politique-cookies/">Politique de cookies</a></li>
        <li><a href="/politique-cookies/" data-open-cookie-settings>Gérer les cookies</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(170deg, var(--navy-900), var(--navy-800));
    color: #c3cfe2;
    padding: clamp(3rem, 6vw, 4.5rem) 0 5.5rem;
    font-size: 0.97rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1fr 1.1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .footer-brand :global(.footer-logo) {
    height: 46px;
    width: auto;
    margin-bottom: 1rem;
  }

  .footer-brand p { max-width: 34ch; }

  .footer-col h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
    margin: 0 0 1.4rem;
    padding: 0;
  }

  .footer-col li { margin-bottom: 0.45rem; }

  .site-footer a:not(.btn) {
    color: #c3cfe2;
    text-decoration: none;
  }

  .site-footer a:hover { color: #ffffff; text-decoration: underline; }

  .footer-contact address {
    font-style: normal;
    margin-bottom: 1.4rem;
  }

  .footer-contact address a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: #fbd38a;
  }

  .hours span { font-weight: 600; color: #e7edf7; }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.6rem;
    font-size: 0.9rem;
  }

  .footer-bottom p { margin: 0; }

  .footer-bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer .btn { text-decoration: none; }
  .site-footer .btn:hover { text-decoration: none; color: var(--navy-900); }

  @media (max-width: 980px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
