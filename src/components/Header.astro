---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company } from '../data/company';
import { navServices } from '../data/services';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <Logo class="brand-logo" />
    </a>

    <nav class="main-nav" aria-label="Navigation principale">
      <ul>
        <li><a href="/" class:list={{ active: isActive('/') }}>Accueil</a></li>
        <li class="has-submenu">
          <a href="/services/" class:list={{ active: isActive('/services/') }}>
            Services
            <Icon name="chevron" size={14} />
          </a>
          <ul class="submenu">
            {navServices.map((s) => (
              <li>
                <a
                  href={s.href}
                  target={s.external ? '_blank' : undefined}
                  rel={s.external ? 'noopener' : undefined}
                >{s.shortTitle}</a>
              </li>
            ))}
          </ul>
        </li>
        <li>
          <a
            href="/demenagement-international/"
            class:list={{ active: isActive('/demenagement-international/') }}
          >Déménagement international</a>
        </li>
        <li><a href="/contact/" class:list={{ active: isActive('/contact/') }}>Contact</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href={company.phoneHref} class="header-phone" aria-label={`Appeler le ${company.phoneDisplay}`}>
        <Icon name="phone" size={18} />
        <span>{company.phoneDisplay}</span>
      </a>
      <a href={company.quoteUrl} target="_blank" rel="noopener" class="btn btn--primary header-cta">Devis gratuit</a>
    </div>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Ouvrir le menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Navigation mobile">
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/services/">Tous nos services</a></li>
        {navServices.map((s) => (
          <li class="sub"><a href={s.href}>{s.shortTitle}</a></li>
        ))}
        <li><a href="/demenagement-international/">Déménagement international</a></li>
        <li><a href="/zones-intervention/">Zones d'intervention</a></li>
        <li><a href="/contact/">Contact & devis</a></li>
      </ul>
    </nav>
    <div class="mobile-menu-ctas">
      <a href={company.phoneHref} class="btn btn--dark">
        <Icon name="phone" size={18} />
        Appeler maintenant
      </a>
      <a href={company.quoteUrl} target="_blank" rel="noopener" class="btn btn--primary">Devis gratuit</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 76px;
  }

  .brand { display: inline-flex; flex-shrink: 0; }
  .brand :global(.brand-logo) { height: 46px; width: auto; }

  .main-nav { margin-left: auto; }

  .main-nav ul {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .main-nav a:hover { background: var(--blue-50); color: var(--navy-800); }
  .main-nav a.active { color: var(--blue-600); }

  .has-submenu { position: relative; }

  /* Pont invisible entre le lien et le sous-menu : sans lui, le survol est
     perdu quand la souris traverse l'espace de 6px et le menu se referme. */
  .has-submenu::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 12px;
  }

  .main-nav .submenu {
    position: absolute;
    z-index: 1;
    top: calc(100% + 6px);
    left: 0;
    min-width: 250px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    padding: 0.5rem;
    display: none;
    flex-direction: column;
    gap: 0.1rem;
  }

  .main-nav .has-submenu:hover .submenu,
  .main-nav .has-submenu:focus-within .submenu {
    display: flex;
  }

  .submenu a { display: block; width: 100%; font-weight: 500; }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    color: var(--navy-800);
    text-decoration: none;
    white-space: nowrap;
  }

  .header-phone:hover { color: var(--blue-600); }

  .header-cta { padding: 0.65rem 1.3rem; font-size: 0.95rem; }

  /* Burger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 8px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav-toggle-bar {
    display: block;
    height: 3px;
    width: 100%;
    border-radius: 2px;
    background: var(--navy-800);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-menu {
    border-top: 1px solid var(--line);
    background: #fff;
    padding: 1rem clamp(1.1rem, 4vw, 2rem) 1.4rem;
    max-height: calc(100dvh - 76px);
    overflow-y: auto;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .mobile-menu li a {
    display: block;
    padding: 0.7rem 0.4rem;
    font-weight: 700;
    color: var(--navy-800);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu li.sub a {
    font-weight: 500;
    color: var(--ink-soft);
    padding-left: 1.4rem;
  }

  .mobile-menu-ctas {
    display: grid;
    gap: 0.7rem;
  }

  @media (max-width: 1080px) {
    .main-nav, .header-actions { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
    if (menu) menu.hidden = open;
  });
</script>
