---
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import AnalyticsBody from '../components/AnalyticsBody.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Tracking from '../components/Tracking.astro';
import { company } from '../data/company';

interface Props {
  title: string;
  description: string;
  /** Objets JSON-LD supplémentaires propres à la page (FAQ, Service, BreadcrumbList…) */
  schema?: object[];
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, schema = [], ogImage = '/og-image.jpg', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Schéma global : entreprise de déménagement (NAP cohérent sur tout le site)
const movingCompanySchema = {
  '@context': 'https://schema.org',
  '@type': 'MovingCompany',
  '@id': `${company.domain}/#organization`,
  name: company.brand,
  legalName: company.legalName,
  url: `${company.domain}/`,
  logo: `${company.domain}/favicon.svg`,
  image: ogImageUrl,
  telephone: company.phoneInternational,
  email: company.email,
  vatID: company.vat,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.street,
    postalCode: company.address.postalCode,
    addressLocality: company.address.city,
    addressCountry: company.address.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.geo.latitude,
    longitude: company.geo.longitude,
  },
  openingHoursSpecification: company.openingHoursSpecification,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: company.phoneInternational,
    email: company.email,
    contactType: 'customer service',
    availableLanguage: ['French'],
    areaServed: ['BE', 'EU'],
  },
  areaServed: [
    { '@type': 'City', name: 'Bruxelles' },
    { '@type': 'Country', name: 'Belgique' },
    { '@type': 'AdministrativeArea', name: 'Europe' },
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${company.domain}/#website`,
  url: `${company.domain}/`,
  name: company.brand,
  inLanguage: 'fr-BE',
  publisher: { '@id': `${company.domain}/#organization` },
};

const allSchemas = [movingCompanySchema, webSiteSchema, ...schema];
---

<!doctype html>
<html lang="fr-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <AnalyticsHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#132b50" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.brand} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <AnalyticsBody />
    <a href="#contenu" class="skip-link">Aller au contenu principal</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <StickyMobileBar />
    <CookieConsent />
    <Tracking />
  </body>
</html>
